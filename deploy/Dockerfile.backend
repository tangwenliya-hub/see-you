# =====================================================================================
# 后端镜像：多阶段构建（Maven 打包 → JRE 运行）
# 构建上下文：仓库根目录
#   docker build -f deploy/Dockerfile.backend -t seeyou-backend .
# =====================================================================================

# ---- 阶段 1：编译打包 ----
FROM maven:3.9-eclipse-temurin-17 AS builder
WORKDIR /build
# 先只复制 pom，利用 Docker 层缓存（依赖不变时不重复下载）
COPY see_you/pom.xml ./pom.xml
RUN mvn -B -q dependency:go-offline
COPY see_you/src ./src
RUN mvn -B -q package -DskipTests

# ---- 阶段 2：运行时 ----
FROM eclipse-temurin:17-jre-jammy
WORKDIR /app

# 非 root 用户运行（安全基线）
RUN useradd -m -u 1001 appuser

COPY --from=builder /build/target/*.jar /app/app.jar

# 上传目录与前端静态目录（后者与 nginx 共享卷，见 docker-compose.yml）
RUN mkdir -p /app/upload /app/frontend-public && chown -R appuser:appuser /app

USER appuser
EXPOSE 8081

# 真实凭据全部来自环境变量（--env-file .env），镜像内不含任何密钥
ENTRYPOINT ["java", "-jar", "/app/app.jar", "--spring.profiles.active=prod"]
