# =====================================================================================
# 部署环境变量模板 —— 复制为 .env 后填写真实值
# .env 已被 .gitignore 忽略；提交到仓库的只有本模板（全是占位符）
# =====================================================================================

# ---- 数据库 ----
DB_USERNAME=root
DB_PASSWORD=改成强密码
# docker-compose 部署保持默认；裸机部署改成 jdbc:mysql://127.0.0.1:3306/see_you?...
DB_URL=jdbc:mysql://mysql:3306/see_you?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
MYSQL_ROOT_PASSWORD=改成强密码

# ---- JWT（务必换成随机长字符串，泄露等于任何人可冒充任意用户）----
JWT_SECRET=改成至少32位的随机字符串

# ---- AI 大模型 ----
AI_API_URL=https://api.deepseek.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=deepseek-chat

# ---- 邮件（找回密码；留空则验证码打进日志）----
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- 文件存储 ----
UPLOAD_PATH=/app/upload
FRONT_PATH=/app/frontend-public

# ---- 端口 ----
SERVER_PORT=8081
