# 本地开发配置模板 —— 复制为 application-local.yml 后填入真实值
# （application-local.yml 已被 .gitignore 忽略，不会进仓库）

spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/see_you?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
    username: root
    # ⚠️ 密码一定要加引号：纯数字密码不加引号会被 YAML 当数字/八进制解析
    password: "你的MySQL密码"

  # 找回密码邮件（QQ 邮箱为例）。留空则自动降级为「接口回显验证码」，
  # 功能仍可跑通，只是不会真的发信。password 填「SMTP 授权码」，不是邮箱登录密码。
  mail:
    username: 你的QQ邮箱@qq.com
    password: 你的SMTP授权码

jwt:
  # ⚠️ 必须换成你自己的随机值，且长度 ≥ 32 个字符（HS256 的密钥长度下限）。
  #    长度不足时后端会直接启动失败，并提示「jwt.secret 长度不足」。
  #    生成方式（任选）：openssl rand -base64 48
  #                     或把下面这行随手改乱（示例值仅用于本地跑通，不要用于任何对外部署）
  secret: CHANGE_ME_local_only_random_string_at_least_32_chars

ai:
  # 不配也能跑，只是 AI 对话功能不可用
  api-key:

upload:
  path: upload
  # 换机器部署时必须改这里，否则图片上传后前端访问不到
  front-path: 本机 frontend/public 的绝对路径

app:
  # 开发态：验证码答案打到日志，方便自测；生产必须 false
  dev-captcha-log: true
